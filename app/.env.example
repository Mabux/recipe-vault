# Copy to .env (same folder) and fill in. Never commit .env.

# Gitea as seen FROM INSIDE the container: use the LAN IP or hostname, not localhost
GITEA_URL=http://192.168.1.10:3000
# your private recipe data repo as owner/repository
GITEA_REPO=your-user/recipe-vault-data
GITEA_BRANCH=main
# Gitea token with "repository: read" only
GITEA_TOKEN=paste-your-token-here

# Port the app is published on
APP_PORT=8095

# Optional: the importer's API (enables "+ Rezept")
#IMPORTER_URL=http://192.168.1.10:8099
