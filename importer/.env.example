# Copy to .env (same folder) and fill in. Never commit .env.

# SSH clone URL of your private recipe data repo (Gitea → repo page → SSH)
REPO_URL=ssh://git@192.168.1.10:2222/your-user/recipe-vault-data.git

# Folder with incoming recipe files (mounted read-only)
INBOX_HOST_PATH=/path/to/recipe-inbox

# Holds secrets/anthropic_api_key, secrets/deploy_key and data/ (default: this folder)
BASE=/path/to/recipe-importer

# Optional
#API_HOST_PORT=8099
#INTERVAL=300
#MAX_FILES_PER_SCAN=10
#MAX_JOBS_PER_HOUR=20
#MODEL=claude-opus-5-5
#EFFORT=medium
# Google Gemini key for generating recipe photos in the app (aistudio.google.com)
#GEMINI_API_KEY=
#IMAGE_MODEL=gemini-2.5-flash-image
